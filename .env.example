# Copy to .env and fill in. NEVER commit .env (it's in .gitignore). Delete it after deploying if you like.

# Supabase → Account (top-right avatar) → Access Tokens → Generate new token
SUPABASE_ACCESS_TOKEN=
# Supabase → your project → Project Settings → General → "Project ID" (e.g. abcdefghijklmnopqrst)
SUPABASE_PROJECT_REF=

# console.anthropic.com → API keys → Create key
ANTHROPIC_API_KEY=

# Passwords for the two logins (choose them)
PARENT_PASSWORD=
DHRUV_PASSWORD=
PARENT_EMAIL=dpatodia@gmail.com
DHRUV_EMAIL=dpatodia+dhruv@gmail.com

# GitHub → Settings → Developer settings → Fine-grained token with: Administration, Contents, Pages, Workflows = Read & write (all repositories, or just this one)
GITHUB_TOKEN=
GITHUB_REPO=YOUR_GITHUB_USERNAME/dhruv-exam-center

# Optional model overrides (defaults: Opus 5.5 for marking + God-mode, Sonnet 5.5 for papers + lessons)
# GEN_MODEL=claude-sonnet-5-5
# GRADE_MODEL=claude-opus-5-5
# GODMODE_MODEL=claude-opus-5-5
# TUTOR_MODEL=claude-sonnet-5-5
